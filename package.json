{
  "name": "vshape-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "serve": "npx http-server -p 8080 -c-1 .",
    "check": "node --check core.js && node --check app.js",
    "test": "node --test tests/",
    "validate": "npm run check && npm run test && npm run build",
    "build": "node scripts/copy-web.js",
    "android": "npm run build && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^5.7.8",
    "@capacitor/core": "^5.7.8",
    "capacitor-health-connect": "^0.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.8"
  }
}
